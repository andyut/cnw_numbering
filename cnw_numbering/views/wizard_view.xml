<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="cnw_numbering_wizard_action" model="ir.actions.act_window">
            <field name="name">Document Numbering</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cnw.numbering.wizard</field>
            <field name="views">[(False, 'form')]</field> 
            <field name="target">new</field>
        </record>

        <record id="cnw_numbering_wizard_form" model="ir.ui.view">
            <field name="name">cnw.numbering.wizard.form</field>
            <field name="model">cnw.numbering.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Document Numbering">

                    <group string="Document Numbering">

                        <field name="suffix" />
                        <field name="docdate" />
                    </group>

                    <footer>
                        <button string="get" name="getnumbering2" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>

                </form>
            </field>
        </record>

 
    </data>
</odoo>