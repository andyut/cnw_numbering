<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="cnw_numbering_list">
      <field name="name">cnw.numbering.list</field>
      <field name="model">cnw.numbering</field>
      <field name="arch" type="xml">
        <list>
          <field name="company_id"/>
          <field name="suffix"/>
          <field name="iyear"/>
          <field name="imonth"/>
          <field name="numbering"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="cnw_numbering_form">
      <field name="name">cnw.numbering.form</field>
      <field name="model">cnw.numbering</field>
      <field name="arch" type="xml">
        <form>
          <group>
          <field name="company_id"/>
          <field name="suffix"/>
          <field name="iyear"/>
          <field name="imonth"/>
          <field name="numbering"/>
          </group>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
 
    <record model="ir.actions.act_window" id="cnw_numbering_action">
      <field name="name">Document Number</field>
      <field name="res_model">cnw.numbering</field>
      <field name="view_mode">list,form</field>
    </record>
   
  </data>
</odoo>